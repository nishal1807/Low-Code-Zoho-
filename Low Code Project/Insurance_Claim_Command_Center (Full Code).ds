/*
 * Author       : nishal.p.2024.aiml_rajala
 * Generated on : 20-Oct-2026 23:14:39
 * Version      : 1.0
 */
 application "Insurance Claim Command Center"
 {
 	date format = "dd-MMM-yyyy"
 	time zone = "Asia/Kolkata"
 	time format = "24-hr"

 	forms
	{
		form Claim_Request_Form
		{
			success message = "Data Added Successfully!"
			Section_A
			(
				type = section
				displayname = "Section"
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Claim_ID
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Policy_Number
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Claimant_name
			(
    			type = name
				displayname = "Claimant_Name"
     			prefix
     			(
	     			 type = prefix
	     			 displayname ="Prefix"
	     			 visibility = false
	     			 value = {"Mr.","Mrs.","Ms."}
     			) 
     			first_name
     			(
	     			 type = first_name
	     			 displayname ="First Name"
     			) 
     			last_name
     			(
	     			 type = last_name
	     			 displayname ="Last Name"
	     			 visibility = false
     			) 
     			suffix
     			(
	     			 type = suffix
	     			 displayname ="Suffix"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Claimant_Email
			(
    			type = email
				maxchar = 80
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Claimant_Type
			(
				type = picklist
				maxchar = 100
				values = {"Policy Holder","Nominee","Third Party"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Claim_Type
			(
				type = picklist
				maxchar = 100
				values = {"Vehicle","Property","Life","Health","Travel"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Claim_Amount_Requested
			(
				type = INR
				format = commadotindian
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Date_Of_Incident
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Claim_Submitted_On
			(
    			type = datetime
				initial value = "${zoho.currenttime}"
				timedisplayoptions = "hh:mm:ss"
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Residential_Address
			(
    			type = address
     			capture_coordinates = true
     			adjust_using_map = false
     			address_line_1
     			(
	     			  type = address_line_1
	     			  displayname = "Address Line 1"
     			) 
     			address_line_2
     			(
	     			  type = address_line_2
	     			  displayname = "Address Line 2"
	     			 visibility = false
     			) 
     			district_city
     			(
	     			  type = district_city
	     			  displayname = "City / District"
	     			 visibility = false
     			) 
     			state_province
     			(
	     			  type = state_province
	     			  displayname = "State / Province"
	     			 visibility = false
     			) 
     			postal_Code
     			(
	     			  type = postal_Code
	     			  displayname = "Postal Code"
	     			 visibility = false
     			) 
     			country
     			(
	     			  type = country
	     			  displayname = "Country"
	     			 visibility = false
     			) 
     			latitude
     			(
	     			  type = latitude
	     			  displayname = "latitude"
	     			 visibility = false
     			) 
     			longitude
     			(
	     			  type = longitude
	     			  displayname = "longitude"
	     			 visibility = false
     			) 
	 			row = 1
	 			column = 1   
				width = medium
				personal data = true
			)
			must have Claim_Status
			(
				type = picklist
				maxchar = 100
				values = {"Submitted","Under Investigation","Approved","Settled","Rejected"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Investigation_Status
			(
				type = picklist
				maxchar = 100
				values = {"Not Started","In Progress","Completed"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Surveyor_Assigned
			(
    			type = text
	 			row = 1
	 			column = 1   
				width = medium
			)
			Settlement_Status
			(
				type = picklist
				maxchar = 100
				values = {"Pending","Processing","Completed"}
	 			row = 1
	 			column = 1   
				width = medium
			)
			Damage_Photo
			(
    			type = image
				source  = file
				aspect ratio = original
				camera = primary
				show gallery = true
				switch camera = true
	 			row = 1
	 			column = 1   
				width = medium
			)
			Repair_Estimate_Upload
			(
    			type = upload file
				browse = local_drive
	 			row = 1
	 			column = 1   
				width = medium
			)
			Policy_Sum_Insured_Lakhs
			(
				type = decimal
	 			row = 1
	 			column = 1   
				width = medium
			)
			Witness_Details
			(
				type = grid
				Witness_Name
				(
    				type = text
					width = medium
				)
				Contact_Number
				(
    				type = phonenumber
					width = medium
					personal data = true
				)
				Statement
				(
    				type = textarea
					height = 100px
					width = medium
				)
				FIR_Copy_Online_Link
				(
    				type = url
					enable  linkname
					width = medium
				)
				Accident_Scene_Video
				(
    				type = video
    				duration=30
					width = medium
				)
				Incident_Voice_Statement
				(
     				type = audio
    				duration=60
					width = medium
				)
	 			row = 2
	 			column = 1   
				width = medium
			)
			Section
			(
				type = section
				visibility = true
	 			row = 3
	 			column = 0   
				width = medium
			)
			Estimated_Repair_Cost
			(
				type = INR
				format = commadotindian
	 			row = 3
	 			column = 1   
				width = medium
			)
			Depreciation_Percent
			(
    			type = percentage
	 			row = 3
	 			column = 1   
				width = medium
			)
			Policy_Deductible
			(
				type = INR
				format = commadotindian
	 			row = 3
	 			column = 1   
				width = medium
			)
			Net_Payable_Amount
			(
				type = decimal
	 			row = 3
	 			column = 1   
				width = medium
    			Formula_Properties
    			(
    						value =  input.Estimated_Repair_Cost - input.Estimated_Repair_Cost * input.Depreciation_Percent - input.Policy_Deductible
    						visibility = false
    			)
			)
			Claim_Process_Guidelines_Display
			(
    			type = richtext
				height = 200px
				toolbar = enable
				[
					style, font-color, background-color, link, bullets-and-numbering, 
					font-size : {1, 2, 3, 4, 5, 6, 7}
				]
    			description
    			[
    				type = help_text
    			 	message = "Claim Process Guidelines\n\nKeep all original bills and estimates.\nA surveyor will contact you within 48 hours.\nDo not repair the vehicle before inspection."
    			]
	 			row = 3
	 			column = 1   
				width = medium
			)
			Claim_Reference_ID
			(
    			type = autonumber
				start index = 1
	 			row = 3
	 			column = 1   
				width = medium
			)
			QR_Code
			(
				type = qrcode
				displayname = "Claim_Tracking_QR_Code"
				value = "${Claim_Reference_ID}"
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have Is_Third_Party_Involved
			(
    			type = checkbox
				initial value = false
	 			row = 3
	 			column = 1   
				width = medium
			)
			must have Claimant_Digital_Signature
			(
    			type = signature
	 			row = 3
	 			column = 1   
				width = medium
				personal data = true
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
		form Policies
		{
			success message = "Policy Added Successfully"
			Section
			(
				type = section
	 			row = 1
	 			column = 0   
				width = medium
			)
			must have Policy_Number
			(
				type = picklist	
				values  = Claim_Request_Form.ID
    			displayformat = [Policy_Number]
				sortorder = ascending
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Policy
			(
				type = picklist	
				displayname = "Policy_Holder_Name"
				values  = Claim_Request_Form.ID
    			displayformat = [" " + Claimant_name.first_name]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Coverage_Type
			(
				type = picklist	
				values  = Claim_Request_Form.ID
    			displayformat = [Claim_Type]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Sum_Insured
			(
				type = picklist	
				values  = Claim_Request_Form.ID
    			displayformat = [Claim_Amount_Requested]
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Valid_From
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
			must have Valid_Till
			(
    			type = date
				alloweddays = 0,1,2,3,4,5,6
	 			row = 1
	 			column = 1   
				width = medium
			)
	
			actions
			{
				on add
				{
					submit
					(
   						type = submit
   						displayname = "Submit"
					)
				}
				on edit
				{
					update
					(
   						type = submit
   						displayname = "Update"
					)
					cancel
					(
   						type = cancel
   						displayname = "Cancel"
					)
				}
			}
		}
	}
	reports
	{
		default list Claim_Request_Form_Report
		{
			displayName = "Claim_Request_Form Report"
			show all rows from Claim_Request_Form    
			(
				Claim_ID
				Policy_Number
				Claimant_name  as "Claimant_Name"
				Claimant_Type
				Claim_Type
				Claim_Amount_Requested
				Date_Of_Incident
				Claim_Submitted_On
				Residential_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Claim_Status
				Investigation_Status
				Surveyor_Assigned
				Settlement_Status
				Claimant_Email
				Damage_Photo
				Repair_Estimate_Upload
				Policy_Sum_Insured_Lakhs
				Witness_Details.Witness_Name as "Witness_Details"
				Is_Third_Party_Involved
				Estimated_Repair_Cost
				Depreciation_Percent
				Policy_Deductible
				Net_Payable_Amount
				Claim_Process_Guidelines_Display
				Claimant_Digital_Signature
				Claim_Reference_ID
				QR_Code as "Claim_Tracking_QR_Code"
			)
		}
		list All_Claims_List
		{
			displayName = "All_Claims_List"
			show all rows from Claim_Request_Form    
			(
				Claim_ID
				Policy_Number
				Claimant_name  as "Claimant_Name"
				Claimant_Type
				Claim_Type
				Claim_Amount_Requested
				Date_Of_Incident
				Claim_Submitted_On
				Residential_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Claim_Status
				Investigation_Status
				Surveyor_Assigned
				Settlement_Status
			)
			filters
			(
				Claim_Type
				Claimant_Type
				Claim_Status
			)
			sort by
			(
				Date_Of_Incident descending
			)
		}
		spreadsheet Claims_Spreadsheet
		{
			displayName = "Claims_Spreadsheet"
			show all rows from Claim_Request_Form    
			(
				Claim_ID
				Policy_Number
				Claimant_name  as "Claimant_Name"
				Claimant_Type
				Claim_Type
				Claim_Amount_Requested
				Date_Of_Incident
				Claim_Submitted_On
				Residential_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Claim_Status
				Investigation_Status
				Surveyor_Assigned
				Settlement_Status
			)
			sort by
			(
				Claim_Type descending
			)
		}
		kanban Claim_Status_Kanban
		{
			displayName = "Claim_Status_Kanban"
			show all rows from Claim_Request_Form    
			(
				Claim_ID
				Policy_Number
				Claimant_name  as "Claimant_Name"
				Claimant_Type
				Claim_Type
				Claim_Amount_Requested
				Date_Of_Incident
				Claim_Submitted_On
				Residential_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Claim_Status
				Investigation_Status
				Surveyor_Assigned
				Settlement_Status
			)
			options
			(
	 			display field = Claim_Status
				record count  = enable
	 		)
		}
		calendar Incident_Date_Calendar
		{
			displayName = "Incident_Date_Calendar"
			show all rows from Claim_Request_Form    
			(
				Claim_ID
				Policy_Number
				Claimant_name  as "Claimant_Name"
				Claimant_Type
				Claim_Type
				Claim_Amount_Requested
				Date_Of_Incident
				Claim_Submitted_On
				Residential_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Claim_Status
				Investigation_Status
				Surveyor_Assigned
				Settlement_Status
			)
			options
			(
				display field = Date_Of_Incident
				start date = Date_Of_Incident
			)
		}
		map Claimant_Location_Map
		{
			displayName = "Claimant_Location_Map"
			show all rows from Claim_Request_Form    
			(
				Claim_ID
				Policy_Number
				Claimant_name  as "Claimant_Name"
				Claimant_Type
				Claim_Type
				Claim_Amount_Requested
				Date_Of_Incident
				Claim_Submitted_On
				Residential_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Claim_Status
				Investigation_Status
				Surveyor_Assigned
				Settlement_Status
			)
			options
			(
	 			display field = Residential_Address
	 		)
		}
		timeline Claim_Activity_Timeline
		{
			displayName = "Claim_Activity_Timeline"
			show all rows from Claim_Request_Form    
			(
				Claim_ID
				Policy_Number
				Claimant_name  as "Claimant_Name"
				Claimant_Type
				Claim_Type
				Claim_Amount_Requested
				Date_Of_Incident
				Claim_Submitted_On
				Residential_Address 
	 			(
	      			enable = Link_to_Map,Show_As_Text
	 			)
				Claim_Status
				Investigation_Status
				Surveyor_Assigned
				Settlement_Status
			)
			options
			(
				display field = Claim_Submitted_On
				start date = Date_Of_Incident
				end date = Claim_Submitted_On
			)
		}
		default list All_Policies
		{
			displayName = "All Policies"
			show all rows from Policies    
			(
				Policy_Number
				Policy as "Policy_Holder_Name"
				Coverage_Type
				Sum_Insured
				Valid_From
				Valid_Till
			)
		}
		pivottable ClaimType_By_ClaimantType_Pivot
		{
			displayname = "ClaimType_By_ClaimantType_Pivot"
			based on Autoview_1789183840941_Claim_Request_Form
				show all rows from Claim_Request_Form
				(
			Claim_ID 
			Policy_Number 
			Claimant_name  as "Claimant_Name"
 			(
 				first_name as "Claimant_Name"
 				prefix as "Claimant_Name.Prefix"
				displayformat = [first_name+""+prefix]
 			)
			Claimant_Type 
			Claim_Type 
			Investigation_Status 
			Settlement_Status 
				)
		}
		pivotchart ClaimType_Distribution_Chart
		{
			displayname = "ClaimType_Distribution_Chart"
			based on Autoview_1789183840941_Claim_Request_Form
				show all rows from Claim_Request_Form
				(
			Claim_ID 
			Policy_Number 
			Claimant_name  as "Claimant_Name"
 			(
 				first_name as "Claimant_Name"
 				prefix as "Claimant_Name.Prefix"
				displayformat = [first_name+""+prefix]
 			)
			Claimant_Type 
			Claim_Type 
			Investigation_Status 
			Settlement_Status 
				)
		}
	}
	pages
	{
		page Claims_Command_Center_Page
		{
			displayname = "Claims_Command_Center_Page"
			Content="<zml    \t\t\n\t\t\n\t\t\n\t\t\n\t\t\n>\n\t<layout>\n\t<row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Panel'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\thAlign = 'center'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginLeft = '0px'\n\tmarginRight = '0px' \n\tmarginBottom = '1px'\n\tmarginTop = '1px'\n\tpadding = '0px'\n\tcolor = '#333333'\n\tsize = '33px'\n\tfontFamily = 'heuristica, tinos, times, serif' \n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = 'theme'\n    borderWidth = '0px'\n\n\t  value = 'Command_Center_Main_Panel'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<search \n\telementName='Claim_Search_Bar'\n\tpaddingTop = '40px'\n\tpaddingLeft = '80px'\n\tpaddingRight = '80px'\n\tpaddingBottom = '40px'\n\tbgtype = 'none'\n\tbgColor = '#FFFFFF'\n\n\tshape = 'flat'\n\tresultComponent = 'report'\n\tlinkName = 'Claim_Request_Form_Report'\n\ttarget = 'same-window'\n\tcriteriaString = 'Claimant_name.first_name.contains(input.searchString) &amp;&amp; Policy_Number.contains(input.searchString) &amp;&amp; Claim_Reference_ID == input.searchString'\n\tfontFamily = 'default'\n\tallowPublicAccess = 'true'\n\tappLinkName = 'thisapp'\n\tstyle = '1'\n\tplaceholder = 'Enter Value'\n\n>\n<searchbar color=\"#000000\" bgColor=\"#FFFFFF\" fontSize=\"15px\"\n/></search>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<board\n    \n\tbgColor = '#FFFFFF'\n        bgColorType = 'solid'\n\tpadding = '0px'\nelementName='Board'\n    layoutType = 'grid'\n        items = '2'\n    appLinkName = 'thisapp'\n    formLinkName = 'Claim_Request_Form'\n    rankBy = 'ID'\n    rankOrder = 'highestToLowest'\n    rankAggregate = 'count'\n    limit = '3'\n    groupBy = 'Claim_Status'\n>\n<boardHeader>\n    <pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpaddingTop = '14px'\n\tpaddingLeft = '15px'\n\tpaddingRight = '15px'\n\tpaddingBottom = '14px'\n\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<text \n\n\tmargin = '0px'\n\tpadding = '0px'\n\tcolor = '#000000'\n\tsize = '24px'\n\tbold = 'true' \n\ttype = 'Text'\n\n\tbgColor = 'transparent'\n        bgColorType = 'noFill'\n\tcornerRadius = '0px'\n\n\n\n\n\n    borderColor = '#000000'\n    borderWidth = '0px'\n\n\t  value = 'Claim_Status_Board'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</boardHeader>\n<boardLayout\n                paddingRight = '15px'\n                paddingBottom = '14px'\n                paddingLeft = '15px'\n                paddingTop = '2px'\n                itemGap = '10px'\n>\n    <pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '10px'\n\n    borderColor = '#F2F2F2'\n    borderWidth = '1px'\n\t\twidth = '100%'\n\t\thAlign = 'left'\n\t\tvAlign = 'middle'\n    \tcornerRadius = '12px'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t>\n\t<pc \n\t\n>\n\t<image  \n\t\tmarginBottom = '10px'\n\n    borderWidth = '0px'\n\tcolor = '#000000'\n\tbgColor = '#F7F7FB'\n\twidth = '40px'\n\theight = '40px'\n\ttype = 'icon'\n\tvalue = 'shopping-mobile-cart'\n\tsize = '22px'\n\tcornerRadius = '20px'\n\ticonType = 'outline'\n/>\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tmarginBottom = '10px'\n\tcolor = '#000000'\n\tsize = '16px'\n\ttype = 'boardData'\n\n\n    lineHeight = '22'\n    numOfLines = '1'\n\n\n\n\n\n\t  value = 'groupedField'\n>\n</text>\n\n</pc>\n</pr><pr \n\t>\n\t<pc \n\t\n>\n\t<text \n\n\tcolor = 'theme'\n\tsize = '21px'\n\tbold = 'true' \n\ttype = 'boardData'\n\n\n    lineHeight = '28'\n    numOfLines = '1'\n\n\n\n\n\n\t  value = 'rankAggregate'\n>\n</text>\n\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</boardLayout>\n</board>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<chart \n\telementName='Chart'\n\n\ttype = 'Pie'\n\txtitle = 'ClaimType_Distribution_Chart'\n\tbgColor = '#FFFFFF'\n\ttheme = 'theme1'\n\tlegendPos = 'center.top'\n\theightType = 'auto'\n\theightValue = '300px'\n\tappLinkName = 'thisapp'\n\tformLinkName = 'Claim_Request_Form'\n\txfield = 'Claim_Type'\n\tyfields = 'count:Claim_Type'\n\tshowDataLabel = 'true'\n\tunderlyingReport = 'Claim_Request_Form_Report'\n/>\n\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<gauge \n\telementName='Monthly_Settlement_Target_Gauge'\n\n\tcolor = '#000000'\n\tsize = '20px'\n\tfontFamily = 'default' \n\tbgColor = '#FFFFFF'\n\ttheme = '#0BD6B1'\n\tdisplayType = 'actual'\n\ttype = '2'\n\tfilledColor = '#0BD6B1'\n\tnonFilledColor = '#F5F5F5'\n\tneedleColor = '#000000'\n\ttargetColor = '#D8D8D8'\n\tvalue = 'thisapp.Claim_Request_Form.ID.count'\n>\n<target size=\"15px\" color=\"#7F7F7F\" fontFamily=\"default\" value=\"15\"\n/><maximumvalue size=\"15px\" color=\"#7F7F7F\" value=\"50\" \n/>\n</gauge>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Quick_Counter_Claim_Intake_Form'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n>\n\t<button \n\t\tmargin = '0px'\n\tpaddingTop = '12px'\n\tpaddingLeft = '15px'\n\tpaddingRight = '15px'\n\tpaddingBottom = '12px'\n\n    action = 'OpenForm'\n\t\tcomponentLinkName = 'Claim_Request_Form'\n\t\ttarget = 'same-window'\n\tcolor = '#FFFFFF'\n\tsize = '16px'\n    borderColor = '#FFFFFF'\n    borderWidth = '0px'\n\ttext ='Claim_Request_Form'\n\t\tbgColor = '#0072F4'\n\t\tcornerRadius = '3px' \n/>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Full_Claims_Report'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\tpadding = '5px'\n\n>\n\t<pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n>\n\t<text \n\n\tsize = '20px'\n\ttype = 'Text'\n\n\n\n\n\n\n\n\t  value = 'Claim_Request_Form Report'\n>\n</text>\n\n</pc>\n</pr><pr \n\t\t\twidth='fill'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\twidth = '100%'\n>\n\t<button \n\t\n    action = 'OpenReport'\n\t\tcomponentLinkName = 'Claim_Request_Form_Report'\n\t\ttarget = 'new-window'\n\tcolor = '#FFFFFF'\n\tsize = '16px'\n\ttext ='View'\n\t\tbgColor = '#0072F4'\n/>\n</pc>\n</pr>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<dsp id='html_snippet' elementName='Claim_Process_Guidelines_Snippet'\n bgColor=\"#FFFFFF\" \n>\n\t<![CDATA[htmlpage html_snippet()\ncontent\n&lt;%{\n\tinfo &quot;CLAIM PROCESS GUIDELINES&quot;;\n\tinfo &quot;------------------------------&quot;;\n\tinfo &quot;1. Submit the claim form accurately.&quot;;\n\tinfo &quot;2. Verify policy number and validity.&quot;;\n\tinfo &quot;3. Upload damage photos and repair estimates.&quot;;\n\tinfo &quot;4. Add witness details if applicable.&quot;;\n\tinfo &quot;5. Review investigation and settlement amount.&quot;;\n\tinfo &quot;6. Track claims using the Claim Reference ID.&quot;;\n\tinfo &quot;------------------------------&quot;;\n\n}%&gt;]]>\n</dsp>\n</column>\n</row><row>\n\t<column\n   \t\t width='100%'\n   \t>\n\t<panel elementName='Send_Document_Reminder_Button'\n \n >\n\t<pr \n\t\t\twidth='fill'\n\t\theight='fill'\n>\n\t<pc \n\t\tpadding = '20px'\n\tbgColor = '#FFFFFF'\n\n\t\twidth = '100%'\n\t\tvAlign = 'middle'\n>\n\t<pr \n\t\t\twidth='auto'\n\t\theight='auto'\n>\n\t<pc \n\t\n\t\tvAlign = 'middle'\n>\n\t<button \n\t\tmargin = '0px'\n\tpaddingTop = '12px'\n\tpaddingLeft = '15px'\n\tpaddingRight = '15px'\n\tpaddingBottom = '12px'\n\n\tcolor = '#FFFFFF'\n\tsize = '16px'\n    borderColor = '#FFFFFF'\n    borderWidth = '0px'\n\ttext ='Send Document Reminder'\n\t\tbgColor = 'theme'\n\t\tcornerRadius = '60px' \n/>\n</pc>\n</pr>\n</pc>\n</pr>\n</panel>\n</column>\n</row>\n</layout>\n</zml>"
		}
	}




		workflow
		{
		form
		{
			WF_New_Claim_Submission as "WF_New_Claim_Submission"
			{
				type =  form
				form = Claim_Request_Form

				record event = on add

				on success
				{
					actions  (Claim_Status == "Submitted")
					{
						sendmail
						(
							from : "zoho.loginuserid"
							to : Claimant_Email
							subject : "Insurance Claim Submitted - ${Claim_Reference_ID}"
							message : "<div>Dear ${Claimant_Name}, <br></div><div><br></div><div>Your insurance claim has been successfully submitted.<br></div><div><br></div><div>Claim Reference: ${Claim_Reference_ID}<br></div><div>Policy Number: ${Policy_Number}<br></div><div>Claim Type: ${Claim_Type}<br></div><div>Claim Status: ${Claim_Status}<br></div><div><br></div><div>Please keep your Claim Reference ID for future tracking.<br></div><div><br></div><div>Thank you.<br></div><div>Insurance Claims Team<br></div>"
							content type : Plain Text
						)
					}
				}

			}
			WF_Claim_Status_Update as "WF_Claim_Status_Update"
			{
				type =  form
				form = Claim_Request_Form

				record event = on edit

				on success
				{
					actions  (Claim_Status == "Under Investigation")
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : Claimant_Email
							subject : "Dear Claimant"
							message : "<div>${Claim_ID}<br></div><div>${Claimant_name.first_name}<br></div><p><b><span>Your claim is now under investigation</span></b><br></p><p><br></p><div><br></div>"
						)
					}
					actions  (Claim_Status == "Approved")
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : Claimant_Email
							subject : "Dear Claimant"
							message : "<div>${Claim_ID}<br></div><div>${Claimant_name.first_name}<br></div><p><b><span>Your claim has been approved</span></b><br></p><p><br></p><div><br></div>"
						)
					}
					actions  (Claim_Status == "Settled")
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : Claimant_Email
							subject : "Dear Claimant"
							message : "<div>${Claim_ID}<br></div><div>${Claimant_name.first_name}<br></div><p><b><span>Your claim has been settled</span></b><br></p><p><br></p><div><br></div>"
						)
					}
					actions  (Claim_Status == "Rejected")
					{
						sendmail
						(
							from : "zoho.adminuserid"
							to : Claimant_Email
							subject : "Dear Claimant"
							message : "<div>${Claim_ID}<br></div><div>${Claimant_name.first_name}<br></div><p><b><span>Your claim status has been updated</span></b><br></p><p><br></p><div><br></div>"
						)
					}
				}

			}
			WF_Investigation_Complete as "WF_Investigation_Completed"
			{
				type =  form
				form = Claim_Request_Form

				record event = on add or edit

				on success
				{
					actions  (Investigation_Status == "Completed")
					{
					pushnotification
					(
						sender type : "users"
						to : "nishal.p.2024.aiml@rajalakshmi.edu.in"
						title : "Good Morning"
						message : "Investigation Completed\n\nClaim Reference: ${Claim_Reference_ID}\nClaimant: ${Claimant_Name}\nClaim Type: ${Claim_Type}\nEstimated Repair Cost: ${Estimated_Repair_Cost}\nNet Payable Amount: ${Net_Payable_Amount}\n\nThe investigation has been completed.\nPlease review the claim for approval/settlement."
						view: "Claims_Spreadsheet"
					)
					}
				}

			}
			WF_Policy_Verification as "WF_Policy_Verification"
			{
				type =  form
				form = Policies

				record event = on add or edit

				on success
				{
					actions  (Valid_Till < '01-Dec-2026')
					{
					update Claim_Request_Form[Claim_Status != "Rejected"]
					[
						Claim_Status = "Rejected"
					]
					}
				}

			}
		}






	}
	share_settings
	{
			"Read"
			{
				name = "Read"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have read permission for all components\n"
			}
			"Write"
			{
				name = "Write"
				type = Users_Permissions
				permissions = {Chat:false, Predefined:false, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have write permission for all components\n"
				ModulePermissions
				{
					Claim_Request_Form
					{
						enabled= Create,Viewall,Modifyall,Import,Export,Tab 
						ReportPermissions
						{
							Incident_Date_Calendar={"View","Edit","Delete"}
							Claim_Activity_Timeline={"View","Edit","Delete"}
							Claims_Spreadsheet={"View","Edit","Delete"}
							All_Claims_List={"View","Edit","Delete"}
							Claim_Status_Kanban={"View","Edit","Delete"}
							ClaimType_By_ClaimantType_Pivot={"View"}
							Claim_Request_Form_Report={"View","Edit","Delete"}
							Claimant_Location_Map={"View","Edit","Delete"}
							ClaimType_Distribution_Chart={"View"}
						}
						FieldPermissions
						{
							Claim_Process_Guidelines_Display{visibility:false,readonly:false}
							Claim_Submitted_On{visibility:true,readonly:true}
							ZC_Record_Type{visibility:false}
							Is_Third_Party_Involved{visibility:false,readonly:false}
							Net_Payable_Amount{visibility:false,readonly:false}
							QR_Code{visibility:false,readonly:false}
							Damage_Photo{visibility:false,readonly:false}
							Date_Of_Incident{visibility:true,readonly:true}
							Claim_ID{visibility:true,readonly:true}
							Policy_Deductible{visibility:false,readonly:false}
							Policy_Number{visibility:true,readonly:true}
							Claimant_Digital_Signature{visibility:false,readonly:false}
							Claimant_Email{visibility:false,readonly:false}
							Settlement_Status{visibility:true,readonly:false}
							Residential_Address{visibility:true,readonly:true}
							Policy_Sum_Insured_Lakhs{visibility:false,readonly:false}
							Depreciation_Percent{visibility:false,readonly:false}
							Claim_Amount_Requested{visibility:true,readonly:true}
							Claim_Type{visibility:true,readonly:true}
							Witness_Details{visibility:false,readonly:false}
							Repair_Estimate_Upload{visibility:false,readonly:false}
							Section{visibility:false,readonly:false}
							Investigation_Status{visibility:true,readonly:false}
							Claim_Reference_ID{visibility:false,readonly:false}
							Claim_Status{visibility:true,readonly:true}
							Claimant_Type{visibility:true,readonly:true}
							Surveyor_Assigned{visibility:true,readonly:false}
							Claimant_name{visibility:true,readonly:true}
							Section_A{visibility:false,readonly:false}
							Estimated_Repair_Cost{visibility:false,readonly:false}
						}
					}
				}
			}
			"Developer"
			{
				name = "Developer"
				type = Developer
				permissions = {Chat:false, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "Developer Profile\n"
			}
			"Administrator"
			{
				name = "Administrator"
				type = Users_Permissions
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This profile will have all the permissions.\n"
			}
			"Customer"
			{
				name = "Customer"
				type = Customer_Portal
				permissions = {Chat:true, Predefined:true, ApiAccess:true, PIIAccess:true, ePHIAccess:true}
				description = "This is the default profile having only add and view permission.\n"
			}
			roles
			{
				"CEO"
				{
					description = "User belonging to this role can access data of all other users."
				}
			}
	}


